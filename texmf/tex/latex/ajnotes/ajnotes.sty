% No bibliography file is bound here. To add one, put \addbibresource{your.bib}
% in the document's main.tex (after \usepackage[...]{ajnotes}), then \cite / print it.
\DeclareSourcemap{
  \maps[datatype=bibtex]{
    \map{
      \step[fieldsource=url, final=true]
      \step[fieldset=verba, origfieldval, final=true]
      \step[fieldsource=verba, match=\regexp{\A(ht|f)tp(s)?:\/\/}, replace={}]
    }
  }
}
