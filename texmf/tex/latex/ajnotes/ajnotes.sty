  \href{#1}{\nolinkurl{\thefield{verba}}}%
}

\DeclarePairedDelimiter{\p}{(}{)}
\DeclarePairedDelimiter{\abs}{\lvert}{\rvert}
% Integral evaluation: square brackets sized to their contents, with the limits
% written after the closing brace as super/subscripts.
%
%   \int_a^b f'(x) \dif x = \eval{f(x)}_a^b
%   \eval{\frac{x^2}{2}}_0^1 = \frac{1}{2}
%
% \left...\right scales the brackets, and the invisible \rule underneath sets a
% floor on that: on its own \left[ hugs short contents like f(x) far too closely
% for an evaluation bar. The floor is exactly \bigl[...\bigr], measured from the
% document's own font at \begin{document} so it follows the point size. Short
% contents therefore come out \big-sized; taller ones keep growing past it.
\newlength{\ajevalht}\newlength{\ajevaldp}
\AtBeginDocument{%
    \settoheight{\ajevalht}{$\bigl[\bigr]$}%
    \settodepth{\ajevaldp}{$\bigl[\bigr]$}}
\newcommand{\eval}[1]{%
    \left[\vphantom{\rule[-\ajevaldp]{0pt}{\dimexpr\ajevalht+\ajevaldp\relax}}#1\right]}

