% Include an Inkscape figure exported with "omit text in PDF": the drawing comes
% from the .pdf, the labels are typeset here by LaTeX.
%
% Labels are wrapped by Inkscape in \makebox/tabular, where display math ($$...$$
% or \[...\]) is not allowed — it errors with "Missing $ inserted". So \everymath
% switches figure labels to \displaystyle instead: fractions, sums and integrals
% get their full-size form while staying inline math. The group keeps this local
% to the figure, and a label that wants the cramped form can still say
% \textstyle explicitly.
\newcommand{\incfig}[1]{%
    \begingroup%
    \everymath{\displaystyle}%
    \def\svgwidth{\columnwidth}%
    \import{./figures/}{#1.pdf_tex}%
    \endgroup%
}

