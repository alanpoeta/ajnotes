% Author name, shown on the title page and in the running header, plus the other
% per-person settings. Rather than editing this file (which is in the repository),
% put them in a private env.tex:
%
%   \renewcommand{\authorname}{Your Name}
%   \renewcommand{\ajgermanvariant}{ngerman}    % babel dialect; def. nswissgerman
%   \renewcommand{\ajenglishvariant}{british}   % babel dialect; def. american
%   \renewcommand{\ajgermanlocale}{DE}          % siunitx locale; unset by default
%   \renewcommand{\ajenglishlocale}{UK}         % siunitx locale; unset by default
%
% The siunitx locales are opt-in: leave one unset and numbers use the house style
% (decimal point, comma thousands separator, \cdot exponent). Set one and siunitx's
% regional preset wins for that language.
%
% Two locations are checked, nearest first, so a document or course can override
% the machine-wide default:
%
%   ./env.tex          next to the main.tex being compiled  (per document)
%   ajnotes/env.tex    beside this .sty, i.e. in TEXMFHOME  (per machine)
%
% Both are git-ignored. The second is written as a qualified subpath so it keeps
% the plain name env.tex without an unrelated file elsewhere on the TeX search
% path shadowing it. It is read near the top of this file, before babel.
%
% With neither present the name falls back to \ajdefaultauthor, and any single
% document can still override with \author{...} after loading the package.
\author{\authorname}

% No date on the title page: notes span many lectures, and \maketitle would
% otherwise print \today (the last compile date), which is misleading. Each
% lecture's real date is shown in its margin via \lecture. Override per document
% with \date{...} in main.tex if you ever want one.
\date{}
