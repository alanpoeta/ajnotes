% Exercise-sheet answer structure: one explicit command per level, matching a
% typical sheet. You pass the number/letter and the command formats + indents it,
% so the code says exactly which (sub)exercise each block is — no counting.
%   \exercise{1}        -> 1.   (left margin)
%   \subexercise{a}     -> (a)  (indented one level)
%   \subsubexercise{i}  -> i.   (indented two levels)
% Write the answer right after the command; wrapped lines hang under the text.
% Note: these set \leftskip, so exercises should be the last content in the doc; if
% you add more afterwards (e.g. \printbibliography), precede it with \par\leftskip=0pt.
\newcommand{\ajexitem}[2]{% #1 = label position (base indent), #2 = formatted label
    \par\addvspace{\smallskipamount}%
    \leftskip=\dimexpr#1+2em\relax
    \noindent\hspace{-2em}\makebox[2em][l]{#2}\ignorespaces}
\newcommand{\exercise}[1]{\par\addvspace{\medskipamount}\ajexitem{0em}{#1.}}
\newcommand{\subexercise}[1]{\ajexitem{2em}{(#1)}}
\newcommand{\subsubexercise}[1]{\ajexitem{4em}{#1.}}


% \lecture starts a new lecture
%
% Usage:
% \lecture{1}{2026-06-11}{Introduction}
%
% Adds a section heading with the number / title of the lecture and a margin
% paragraph with the date. The date is stored language-neutrally as YYYY-MM-DD and
% formatted below, so it localizes automatically with the package language option.

\usepackage{pgfcalendar}  % for computing the weekday from a date

% Format an ISO date (YYYY-MM-DD) as "<weekday> <day>. <month> <year>" in the
% current language, e.g. "Thu 11. Jun 2026" / "Do 11. Jun 2026". \ajweekday and
% \ajmonth are the localized name tables defined in the language block above.
\newcount\ajjulian \newcount\ajwday
\def\ajparsedate#1-#2-#3\relax{\def\ajyy{#1}\def\ajmm{#2}\def\ajdd{#3}}
\newcommand{\ajlecturedate}[1]{%
    \ajparsedate#1\relax
    \pgfcalendardatetojulian{#1}{\ajjulian}%
    \pgfcalendarjuliantoweekday{\ajjulian}{\ajwday}%
    \ajweekday{\ajwday}\space\the\numexpr\ajdd\relax.\space\ajmonth{\ajmm}\space\ajyy
}

\def\@lecture{}%
\newcommand{\lecture}[3]{
    % Format: "N  Lecture: Title", mimicking a numbered (sub)section heading —
    % the number, then a \quad gap (as LaTeX uses after section numbers), no dot.
    \ifstrempty{#3}{%
        \def\@lecture{#1\quad\lbllecture}%
    }{%
        \def\@lecture{#1\quad\lbllecture: #3}%
    }%
    % The date sits flush-right on the heading line, ending at the text's right
    % margin (not out in the page margin). \normalfont\small so it isn't bold/large
    % like the heading; \frenchspacing so the '.' after the day-of-month (e.g.
    % "11. Jun") gets normal spacing; \mbox keeps the date on one line.
    \subsection*{\@lecture\hfill
        {\normalfont\small\textsf{\frenchspacing\mbox{\ajlecturedate{#2}}}}}
}



% These are the fancy headers.
\usepackage{fancyhdr}
\usepackage{trimclip}  % \clipbox, for truncating an overlong header
\pagestyle{fancy}
\fancyhf{}  % clear all header/footer fields (incl. the package's default page no.)

% Header: author's name on the left (handy e.g. for open-book exam prints; we
% can't use \@author here because \maketitle wipes it after the title page) and
% the current section on the right.
%
% Both are typeset at natural width, so a long section title would run left and
% overprint the name. \ajheader measures the two and degrades in three steps:
%
%   1. both fit       -> full name, full title
%   2. too wide       -> abbreviate the name (initials + surname, then initials)
%   3. still too wide -> drop the name; if the title alone still overflows,
%                        truncate it with an ellipsis
%
% \ajheadergap is the minimum space kept between name and title.
\newlength{\ajheadergap}
\setlength{\ajheadergap}{1.5em}
\newsavebox{\ajheadbox}
\newlength{\ajheadwd}
\newlength{\ajtitlewd}
\newlength{\ajavail}

\makeatletter
% Width of #2 once typeset, stored in the length #1.
\newcommand{\aj@measure}[2]{\sbox{\ajheadbox}{#2}\setlength{#1}{\wd\ajheadbox}}

% Walk a space-separated name. \aj@short keeps the last word in full
% ("A. J. P. Ferreira"); \aj@inits abbreviates every word ("A. J. P. F.").
% The argument is expanded first (\authorname is a macro, so the loop would
% otherwise see one token instead of the words), and the recursion stops on a
% sentinel rather than on an emptiness test.
% The list is terminated by a trailing space, so the tail #2 is empty exactly
% on the last word; \aj@ifempty tests that without expanding anything.
\long\def\aj@ifempty#1{%
    \romannumeral-`\q\aj@ifemptyA#1\aj@nilA\aj@nilB\aj@nilC}
\long\def\aj@ifemptyA#1\aj@nilA#2\aj@nilC{%
    \ifx\relax#1\relax\expandafter\@firstoftwo\else\expandafter\@secondoftwo\fi}
\def\aj@short#1{\expandafter\aj@shortA#1 \@nil}
\def\aj@shortA#1 #2\@nil{%
    \aj@ifempty{#2}{#1}{\aj@ini{#1}\aj@shortA#2\@nil}}
\def\aj@inits#1{\expandafter\aj@initA#1 \@nil}
\def\aj@initA#1 #2\@nil{%
    \aj@ini{#1}\aj@ifempty{#2}{}{\aj@initA#2\@nil}}
% First letter of #1, followed by a full stop and a space.
\def\aj@ini#1{\aj@iniA#1\@nil}
\def\aj@iniA#1#2\@nil{#1.\space}

% Does `name + gap + title' fit in \headwidth?
\newif\ifaj@fits
\newcommand{\aj@try}[1]{%
    \aj@measure{\ajheadwd}{#1}%
    \ifdim\dimexpr\ajheadwd+\ajtitlewd+\ajheadergap\relax<\headwidth
        \aj@fitstrue\else\aj@fitsfalse\fi}

\newcommand{\ajheader}{%
    \begingroup
    % Don't expand \leftmark: it carries \@mkboth material with parameter
    % tokens, which would break \edef. Just alias it and typeset it twice.
    \def\aj@ttl{\nouppercase{\leftmark}}%
    \aj@measure{\ajtitlewd}{\aj@ttl}%
    \aj@try{\authorname}%
    \ifaj@fits
        \authorname\hfill\aj@ttl
    \else
        \aj@try{\aj@short{\authorname}}%
        \ifaj@fits
            \aj@short{\authorname}\hfill\aj@ttl
        \else
            \aj@try{\aj@inits{\authorname}}%
            \ifaj@fits
                \aj@inits{\authorname}\hfill\aj@ttl
            \else
                % No room for a name at all.
                \ifdim\ajtitlewd<\headwidth
                    \hfill\aj@ttl
                \else
                    % Truncate: set the title on one line in a box of the
                    % available width and clip the overflow, then add an
                    % ellipsis. \hss lets the long line stick out of the box
                    % without a warning; the clip keeps it off the page edge.
                    % Clip the right-hand overflow, then append an ellipsis.
                    % \clipbox wants plain lengths, so compute the cut first.
                    \aj@measure{\ajavail}{\dots}%
                    \setlength{\ajavail}{\dimexpr\headwidth-\ajavail\relax}%
                    \setlength{\ajheadwd}{\dimexpr\ajtitlewd-\ajavail\relax}%
                    \clipbox{0pt 0pt \ajheadwd{} 0pt}{\hbox{\aj@ttl}}\dots
                \fi
            \fi
        \fi
    \fi
    \endgroup}
\makeatother

% One full-width field: \hbox to \headwidth lets the \hfill inside \ajheader
% push the title to the right margin. (\makebox would centre the content and
% swallow the glue.)
\fancyhead[L]{}%
\fancyhead[R]{}%
\fancyhead[C]{\hbox to \headwidth{\ajheader}}
\fancyfoot[R]{\thepage}

% \maketitle (and similar) switch to the 'plain' page style, which by default
% centers the page number. Redefine it to match 'fancy': page number bottom
% right, no header, so numbering is consistent on every page.
\fancypagestyle{plain}{%
    \fancyhf{}%
    \fancyfoot[R]{\thepage}%
    \renewcommand{\headrulewidth}{0pt}%
}




