% Boxed, numbered environments.
% 'theorem' is the master counter, numbered by section (Theorem 2.1, 2.2, ...).
% All other results share that counter, so everything interleaves in one
% unambiguous sequence (Definition 2.1, Theorem 2.2, Lemma 2.3, ...).
\newmdtheoremenv[nobreak=true]{theorem}{\lbltheorem}[section]
\newmdtheoremenv[nobreak=true]{definition}[theorem]{\lbldefinition}
\newmdtheoremenv[nobreak=true]{property}[theorem]{\lblproperty}
\newmdtheoremenv[nobreak=true]{lemma}[theorem]{\lbllemma}
\newmdtheoremenv[nobreak=true]{prop}[theorem]{\lblprop}
\newmdtheoremenv[nobreak=true]{corollary}[theorem]{\lblcorollary}
\newmdtheoremenv[nobreak=true]{law}[theorem]{\lbllaw}
\newmdtheoremenv[nobreak=true]{postulate}[theorem]{\lblpostulate}
\newmdtheoremenv{conclusion}[theorem]{\lblconclusion}
\newmdtheoremenv{bonus}[theorem]{\lblbonus}
\newmdtheoremenv{conjecture}[theorem]{\lblconjecture}

